# ====================================================
# ITBIS - Insider Threat Behavioral Intelligence System
# Environment Variable Configuration Template (.env.example)
# ====================================================

# Backend & JWT Security Configuration
SECRET_KEY=your_secure_random_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL Database Configuration
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/itbis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=itbis

# MongoDB Database Configuration
MONGO_URL=mongodb://localhost:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=itbis

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000
